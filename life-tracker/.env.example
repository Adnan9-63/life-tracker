# Copy this file to .env and fill in your own Supabase project values.
# Find these in your Supabase dashboard: Project Settings > API.
# The anon/public key is safe to expose in client code — access control is
# enforced by Row Level Security policies in the database (see supabase/schema.sql).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
